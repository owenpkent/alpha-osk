{
  "name": "alpha-osk-telemetry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "predeploy": "npm run sbom",
    "deploy": "wrangler deploy",
    "schema:local": "wrangler d1 execute alpha-osk-telemetry --local --file schema.sql",
    "schema:remote": "wrangler d1 execute alpha-osk-telemetry --remote --file schema.sql",
    "sbom": "npm sbom --sbom-format cyclonedx --sbom-type application > cf-worker-sbom.cyclonedx.json"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.145.0"
  },
  "overrides": {
    "ws": "^8.20.1",
    "undici": "^7.29.0",
    "sharp": "^0.35.4"
  }
}
